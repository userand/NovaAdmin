# Nova Admin · Docker 部署配置
# 使用：cp .env.example .env  →  修改下面标注"必填"的项  →  docker compose up -d --build
# 生成随机密钥：  openssl rand -hex 32     (Windows PowerShell 可用：[guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N'))

# ======================= 必填 =======================
# MySQL root 密码(仅容器内部管理用)
MYSQL_ROOT_PASSWORD=
# 应用连接数据库使用的普通账号密码(不能是 root / 默认值)
DB_PASS=
# 后台令牌签名密钥：至少 16 位随机字符，两个必须不同。使用弱值或默认值时，生产模式会拒绝启动
JWT_SECRET=
JWT_REFRESH_SECRET=

# ======================= 常用 =======================
# 对外访问端口(宿主机)。已被占用时改成 8080 等
WEB_PORT=80
# 数据库账号名，一般无需修改
DB_USER=nova
# 允许跨域访问 API 的前端来源，逗号分隔。经 Nginx 同源访问时保持默认即可；
# 有 H5 / 独立域名的前端时填写，例如 https://h5.example.com
CORS_ORIGIN=http://localhost
# 是否开放接口文档(/api/docs)。生产建议关闭
SWAGGER_ENABLED=false
# 后台令牌有效期
JWT_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d
# 会员(移动端)令牌有效期
APP_JWT_EXPIRES=2h
APP_JWT_REFRESH_EXPIRES=30d

# ======================= 会员中心：短信 / 邮件 / 微信 =======================
# 不配置时验证码只写服务端日志，会员收不到真实短信/邮件；请上线前按需接入。
# 短信：console(默认，仅写日志) | aliyun(注意：阿里云对接代码未经真实账号联调，上线前务必验证)
SMS_PROVIDER=console
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 邮件(SMTP)。MAIL_HOST 为空则只写日志
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# 微信：mp 小程序 / app 移动应用(开放平台) / h5 公众号网页授权。生产环境不允许模拟登录
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_APP_APPID=
WECHAT_APP_SECRET=
WECHAT_H5_APPID=
WECHAT_H5_SECRET=
