# ===== Nova Admin Server 环境配置 =====
# 服务
PORT=3200
# 数据库 (MySQL 5.7+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=nova_admin
DB_SYNC=false
# JWT
JWT_SECRET=nova-admin-jwt-secret-change-me-in-production
JWT_EXPIRES=2h
JWT_REFRESH_SECRET=nova-admin-jwt-refresh-secret-change-me-in-production
JWT_REFRESH_EXPIRES=7d
# 前端地址(CORS)
CORS_ORIGIN=http://localhost:5173
# 是否开启 Swagger 文档
SWAGGER_ENABLED=true

# ===== 会员中心(手机/邮箱/微信登录 + 移动端接口) =====
# 生产环境务必设置 NODE_ENV=production：会关闭 debugCode 回传和微信模拟登录
# NODE_ENV=production
# 会员令牌有效期(与后台令牌独立)
APP_JWT_EXPIRES=2h
APP_JWT_REFRESH_EXPIRES=30d
# 短信：console(默认，只写日志) | aliyun
SMS_PROVIDER=console
# ALIYUN_SMS_KEY_ID=
# ALIYUN_SMS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# 邮件(SMTP)：不配置 MAIL_HOST 时只写日志
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM="Nova <noreply@example.com>"
# 微信：mp 小程序 / app 移动应用(开放平台) / h5 公众号网页授权
# WECHAT_MP_APPID=
# WECHAT_MP_SECRET=
# WECHAT_APP_APPID=
# WECHAT_APP_SECRET=
# WECHAT_H5_APPID=
# WECHAT_H5_SECRET=
# 开发联调：模拟发送时把验证码回传在接口响应(debugCode)里；生产环境无论如何都不会回传
MEMBER_DEBUG_CODE=true
# 未配置微信凭据时，开发环境用模拟登录(openid=mock_<平台>_<code>)
WECHAT_MOCK=true
